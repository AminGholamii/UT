create_table users name string required; age int optional
insert into users name:kourosh; age:22
insert into users name:parisa; age:18
insert into users name:amin; age:30

create_enhanced_table students student_id int required; name string optional; last_name string optional
insert into students student_id:1; name:kourosh; last_name:alinaghi
insert into students student_id:2; name:parisa; last_name:yahyapour
insert into students student_id:3; name:amin; last_name:gholami

update students where student_id = 2 set last_name karimi
update users where age < 25 set name young

select name from users where age < 30
select name;last_name from students where student_id != 1

drop_table users
select name from users where age = 22
